{
  "functions": {
    "api/*.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/register", "destination": "/api/auth?action=register" },
    { "source": "/api/auth/reset-password", "destination": "/api/auth?action=reset-password" },
    { "source": "/api/cart/sync", "destination": "/api/cart?action=sync" },
    { "source": "/api/orders/:id", "destination": "/api/orders?id=:id" },
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" },
    { "source": "/api/shiprocket/webhook", "destination": "/api/shiprocket?action=webhook" },
    { "source": "/api/admin/orders", "destination": "/api/admin?resource=orders" },
    { "source": "/api/admin/products", "destination": "/api/admin?resource=products" }
  ]
}
