# Supabase Configuration
# The URL and anon key are embedded into the browser build by vite.config.ts.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Service Configuration (Optional)
EMAIL_SERVICE_API_KEY=your_email_service_api_key

# Shiprocket Configuration (server-side only)
SHIPROCKET_EMAIL=your_shiprocket_api_user_email
SHIPROCKET_PASSWORD=your_shiprocket_api_user_password
SHIPROCKET_PICKUP_LOCATION=your_saved_shiprocket_pickup_location
SHIPROCKET_WEBHOOK_SECRET=use_a_long_random_secret
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=10
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=10
